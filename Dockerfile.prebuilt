# A small runtime image for hosts that should not download a Go build toolchain.
# Context must contain a static Linux binary and a public CA certificate bundle.
FROM scratch
COPY mihomo-policy /usr/local/bin/mihomo-policy
COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
WORKDIR /app
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/mihomo-policy"]
CMD ["serve", "--config", "/app/local/runtime.yaml"]
